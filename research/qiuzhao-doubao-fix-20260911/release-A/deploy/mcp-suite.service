[Unit]
Description=MCP Suite authenticated recruitment service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcp-suite
Group=mcp-suite
WorkingDirectory=/opt/mcp-suite
Environment=MCP_DB_PATH=/var/lib/mcp-suite/access.sqlite3
Environment=MCP_JOBS_PATH=/var/lib/mcp-suite/jobs.json
Environment=MCP_PUBLIC_BASE_URL=https://savegems.top/qiuzhao
ExecStart=/opt/mcp-suite/.venv/bin/uvicorn core.server:app --host 127.0.0.1 --port 8768 --no-access-log --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mcp-suite

[Install]
WantedBy=multi-user.target
